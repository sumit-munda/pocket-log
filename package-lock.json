{
  "name": "pocket-log",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pocket-log",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@pocket-log/api",
      "version": "1.0.0"
    },
    "apps/web": {
      "name": "@pocket-log/web",
      "version": "1.0.0"
    },
    "node_modules/@pocket-log/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@pocket-log/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@pocket-log/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@pocket-log/shared",
      "version": "1.0.0"
    }
  }
}
