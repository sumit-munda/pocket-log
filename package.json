{
  "name": "pocket-log",
  "version": "1.0.0",
  "private": true,
  "description": "An offline-first personal journaling and activit-tracking application.",
  "main": "index.js",
  "scripts": {
    "dev:web": "npm run dev --workspace=@pocket-log/web",
    "dev:api": "npm run dev --workspace=@pocket-log/api",
